/**
 * Cloudflare Functions 的独立类型检查配置
 *
 * 为什么要单独一份：
 * 主 tsconfig 带 DOM lib，而 Workers 运行时没有 DOM；
 * 两套 lib 混在一起会产生大量互相打架的声明。
 * 所以 functions/ 单独一份，只挂 Workers 类型。
 *
 * 许可：AGPL-3.0-only
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["functions/**/*.ts"]
}
