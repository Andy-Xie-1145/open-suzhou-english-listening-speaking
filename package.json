{
  "name": "open-english-ls",
  "version": "0.1.0",
  "description": "开源自托管的英语听说评测 —— 零服务端、BYOK、浏览器端运行",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs rules",
    "test:all": "node scripts/run-tests.mjs",
    "test:suzhou": "node scripts/run-tests.mjs suzhou-",
    "test:rules": "node --experimental-strip-types tests/rules.test.ts",
    "test:reading": "node --experimental-strip-types tests/reading.test.ts",
    "test:listening": "node --experimental-strip-types tests/listening.test.ts",
    "test:summary": "node --experimental-strip-types tests/summary.test.ts",
    "test:normalize": "node --experimental-strip-types tests/normalize.test.ts",
    "test:engine": "node --experimental-strip-types tests/engine.test.ts",
    "test:materials": "node --experimental-strip-types tests/materials.test.ts",
    "test:ui": "node --experimental-strip-types tests/ui.test.ts",
    "test:e2e": "node --experimental-strip-types tests/e2e.test.ts",
    "test:wording": "node --experimental-strip-types tests/wording.test.ts",
    "test:asr-provider": "node --experimental-strip-types tests/asr-provider.test.ts",
    "test:suzhou-listening": "node --experimental-strip-types tests/suzhou-listening.test.ts",
    "test:suzhou-listening-audio": "node --experimental-strip-types tests/suzhou-listening-audio.test.ts",
    "test:suzhou-listening-session": "node --experimental-strip-types tests/suzhou-listening-session.test.ts",
    "test:suzhou-listening-ui": "node --experimental-strip-types tests/suzhou-listening-ui.test.ts",
    "test:suzhou-speaking": "node --experimental-strip-types tests/suzhou-speaking.test.ts",
    "bank:export": "node scripts/bank-export.mjs",
    "audio:check": "node --experimental-strip-types scripts/build-listening-audio.ts --check",
    "audio:build": "node --experimental-strip-types scripts/build-listening-audio.ts",
    "release": "npm run audio:build && npm run build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name openels --branch master",
    "bank:export": "node scripts/export-jsonl.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "cf": "^1.0.0-beta.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "espeak-phonemizer": "^0.1.2"
  }
}